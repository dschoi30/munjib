[Unit]
Description=Munjib anonymous Trial edge proof signer
After=network.target

[Service]
Type=simple
User=10001
Group=10001
LoadCredential=trial-edge-proof-secret:/etc/munjib/secrets/trial-edge-proof-secret
ExecStart=/usr/local/libexec/munjib-trial-edge
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
UMask=0077
LimitNOFILE=256
TasksMax=64
MemoryMax=64M

[Install]
WantedBy=multi-user.target
