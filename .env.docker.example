DOCKER_DATABASE_URL="postgresql://obsidian:obsidian@postgres:5432/obsidian_clone?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="obsidian-clone-development-secret"
POSTGRES_PORT="55432"
WEB_PORT="3000"
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# RAG provider settings. Providers: ollama, openai, openai-compatible.
MUNJIB_RAG_CHAT_PROVIDER=ollama
MUNJIB_RAG_EMBED_PROVIDER=ollama
MUNJIB_OLLAMA_BASE_URL=http://host.docker.internal:11434
MUNJIB_RAG_CHAT_MODEL=gemma4:e4b
MUNJIB_RAG_EMBED_MODEL=bge-m3
MUNJIB_RAG_EMBED_DIMENSIONS=1024

# Official OpenAI provider settings. OPENAI_API_KEY is preferred; MUNJIB_OPENAI_API_KEY is also accepted.
OPENAI_API_KEY=
MUNJIB_OPENAI_API_KEY=
MUNJIB_OPENAI_BASE_URL=

# OpenAI-compatible provider settings. API key is optional for local unauthenticated endpoints;
# when blank, the app supplies a non-secret SDK placeholder while using this base URL.
MUNJIB_OPENAI_COMPATIBLE_BASE_URL=
MUNJIB_OPENAI_COMPATIBLE_API_KEY=

# Optional Langfuse tracing. Metadata mode does not attach a Langfuse callback, so
# prompts, retrieved context, questions, and answers stay out of Langfuse by default.
# Set MUNJIB_LANGFUSE_CAPTURE_MODE=full only for explicit full LangChain tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_HOST=
LANGFUSE_BASEURL=
LANGFUSE_BASE_URL=
MUNJIB_LANGFUSE_CAPTURE_MODE=metadata
MUNJIB_LANGFUSE_CAPTURE=metadata
