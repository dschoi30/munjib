{
  "name": "obsidian-clone",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "pnpm run db:seed && playwright test",
    "test:e2e:ui": "pnpm run db:seed && playwright test --ui",
    "test:security-runtime": "bash scripts/test/run-security-runtime-smoke.sh",
    "test:watch": "vitest",
    "wiki:find": "tsx scripts/wiki/find.ts",
    "wiki:log": "tsx scripts/wiki/log.ts",
    "wiki:lint": "tsx scripts/wiki/lint.ts",
    "wiki:manifest": "tsx scripts/wiki/manifest.ts",
    "wiki:feature-start": "tsx scripts/wiki/feature-start.ts",
    "wiki:install-hooks": "git config core.hooksPath .githooks",
    "wiki:sync-check": "tsx scripts/wiki/sync-check.ts",
    "wiki:sync-plan": "tsx scripts/wiki/sync-plan.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && pnpm run db:rag:index",
    "db:rag:index": "tsx scripts/db/ensure-rag-vector-index.ts",
    "delivery:build-bundle": "tsx scripts/deploy/build-delivery-bundle.ts",
    "delivery:verify-bundle": "tsx scripts/deploy/verify-delivery-bundle.ts",
    "vault:lab:up": "bash scripts/vault-lab/up.sh",
    "vault:lab:bootstrap": "bash scripts/vault-lab/bootstrap.sh",
    "vault:lab:test": "bash scripts/vault-lab/integration.sh",
    "vault:lab:down": "bash scripts/vault-lab/down.sh",
    "db:seed": "tsx scripts/db/seed.ts",
    "security:bootstrap-owner": "tsx scripts/security/bootstrap-owner.ts",
    "documents:purge-archived": "tsx scripts/documents/purge-archived.ts",
    "trial-ai:purge-retention": "tsx scripts/rag/purge-trial-ai-retention.ts",
    "security:auth-preflight": "tsx scripts/security/auth-preflight.ts",
    "rag:eval": "tsx scripts/rag/eval.ts",
    "rag:eval:compare": "tsx scripts/rag/eval-compare.ts",
    "rag:eval:calibrate": "tsx scripts/rag/eval-calibrate.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@langchain/core": "^1.1.49",
    "@langchain/ollama": "^1.2.7",
    "@langchain/openai": "^1.4.7",
    "@langfuse/langchain": "^5.4.1",
    "@langfuse/otel": "^5.4.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "10.75.2",
    "@uiw/react-codemirror": "^4.25.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "next-auth": "^4.24.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "tsx": "^4.19.2",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@langfuse/client": "5.4.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.28",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx scripts/db/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "uuid": "11.1.1",
      "minimatch@10.2.5>brace-expansion": "5.0.12",
      "@opentelemetry/core": "2.8.0",
      "@opentelemetry/propagator-jaeger": "2.9.0",
      "fast-uri": "3.1.9",
      "nanoid": "3.3.18",
      "protobufjs": "7.6.5",
      "sharp": "0.35.5",
      "deepmerge-ts": "8.0.0",
      "tsx>esbuild": "0.28.1",
      "browserslist": "4.28.7",
      "@grpc/grpc-js": "1.14.5",
      "baseline-browser-mapping": "2.11.0",
      "source-map-js": "1.2.2",
      "zod@4": "4.6.6"
    }
  }
}
